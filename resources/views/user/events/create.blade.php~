    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function previewCoverImage() {
            const input = document.getElementById('cover_image_input');
            const preview = document.getElementById('cover_preview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();

                reader.onload = function(e) {
                    if (preview) {
                        preview.src = e.target.result;
                        preview.classList.remove('d-none');
                    } else {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.className = 'cover-preview d-none';
                        img.id = 'cover_preview';
                        document.querySelector('[for="cover_image_input"]').appendChild(img);
                    }
                };

                reader.readAsDataURL(input.files[0]);
            }
        }

        document.getElementById('cover_image_input').addEventListener('change', previewCoverImage);

        document.getElementById('eventForm').addEventListener('submit', function(e) {
            const typeSelect = document.getElementById('type');

            if (!typeSelect || !typeSelect.value) {
                e.preventDefault();
                Swal.fire({
                    title: 'Please select an event type',
                    icon: 'warning',
                    confirmButtonColor: '#7c3aed'
                });
            }
        });

        if (window.flatpickr) {
            flatpickr('#event_date', {
                enableTime: true,
                dateFormat: 'Y-m-d H:i',
                time_24hr: true,
                minDate: 'today'
            });
        }
    </script>
