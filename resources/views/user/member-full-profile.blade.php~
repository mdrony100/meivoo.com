    <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/lightgallery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/plugins/thumbnail/lg-thumbnail.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.7.2/plugins/zoom/lg-zoom.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const composeInput = document.getElementById('composeInput');
            const imagesInput = document.getElementById('imagesInput');
            const imagesSelectedText = document.getElementById('imagesSelectedText');
            const galleries = document.querySelectorAll('.js-lightgallery');


            galleries.forEach(function(gallery) {
                const items = JSON.parse(gallery.dataset.galleryItems || '[]')
                    .filter(function(item) {
                        return item && item.src;
                    });
                const triggers = gallery.querySelectorAll('[data-gallery-index]');
                let galleryInstance = null;

                function destroyGalleryInstance() {
                    if (galleryInstance && typeof galleryInstance.destroy === 'function') {
                        galleryInstance.destroy();
                    }
                    galleryInstance = null;
                }

                triggers.forEach(function(trigger) {
                    trigger.addEventListener('click', function(event) {
                        event.preventDefault();

                        const index = Number(this.dataset.galleryIndex || 0);

                        destroyGalleryInstance();

                        galleryInstance = lightGallery(gallery, {
                            dynamic: true,
                            dynamicEl: items,
                            plugins: [lgZoom, lgThumbnail],
                            speed: 300,
                            download: false,
                        });

                        if (galleryInstance && typeof galleryInstance.openGallery ===
                            'function') {
                            galleryInstance.openGallery(index);
                        }
                    });
                });
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            lightGallery(document.getElementById('family-gallery'), {
                selector: 'a',
                plugins: [lgZoom, lgThumbnail],
                speed: 400,
                download: false,
                counter: true,
                thumbnail: true,
                zoom: true,
            });
        });
    </script>
    <script>
        function toggleReplySmooth(formId) {
            const formWrapper = document.getElementById(formId);

            formWrapper.classList.toggle('is-open');

            if (formWrapper.classList.contains('is-open')) {
                setTimeout(() => {
                    formWrapper.querySelector('input').focus();
                }, 100);
            }
        }
    </script>
    <script>
        function sharePost(url, title) {
            if (navigator.share) {
                navigator.share({
                    title: title,
                    url: url
                }).then(() => {
                    console.log('Thanks for sharing!');
                }).catch(console.error);
            } else {
                navigator.clipboard.writeText(url).then(() => {
                    alert("Link copied to clipboard!");
                });
            }
        }
    </script>

    <script>
        document.addEventListener('click', function(e) {
            if (e.target.innerText === 'See more' || e.target.innerText === 'See less') {
                let btn = e.target;
                let textDiv = btn.previousElementSibling;

                if (btn.innerText === 'See more') {
                    document.querySelectorAll('.text-area.show-all').forEach(div => {
                        div.classList.remove('show-all');
                        if (div.nextElementSibling) {
                            div.nextElementSibling.innerText = 'See more';
                        }
                    });
                }

                textDiv.classList.toggle('show-all');
                btn.innerText = textDiv.classList.contains('show-all') ? 'See less' : 'See more';
            }
        });

        function checkButtons() {
            document.querySelectorAll('.text-area').forEach(div => {
                let btn = div.nextElementSibling;
                if (div.scrollHeight > 70) {
                    btn.style.display = 'block';
                } else {
                    btn.style.display = 'none';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', checkButtons);

        document.addEventListener('click', function(e) {
            if (e.target.matches('.nav-link') || e.target.closest('.nav-link')) {
                setTimeout(checkButtons, 300);
            }
        });
    </script>
    <script>
        document.querySelectorAll('.toggle-comments').forEach(button => {
            button.addEventListener('click', function() {
                const postId = this.getAttribute('data-post-id');
                const container = document.getElementById('comment-section-' + postId);
                const hiddenComments = container.querySelectorAll('.hidden-comment');

                if (hiddenComments.length > 0) {
                    hiddenComments.forEach(el => el.classList.remove('hidden-comment'));
                    this.innerText = 'View less comments';
                } else {
                    const allComments = container.querySelectorAll('.comment-wrapper');
                    allComments.forEach((el, index) => {
                        if (index >= 2) {
                            el.classList.add('hidden-comment');
                        }
                    });
                    this.innerText = 'View more comments';
                }
            });
        });
    </script>
