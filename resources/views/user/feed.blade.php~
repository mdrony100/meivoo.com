        function toggleReplySmooth(formId) {
            const formWrapper = document.getElementById(formId);

            formWrapper.classList.toggle('is-open');

            if (formWrapper.classList.contains('is-open')) {
                setTimeout(() => {
                    formWrapper.querySelector('input').focus();
                }, 100);
            }
        }
